/* HPR-only semantic UI Toolkit styles. Never restyle other Editor windows. */
.hpr-suite-root {
    flex-grow: 1;
    padding-top: 15px;
    padding-right: 19px;
    padding-bottom: 20px;
    padding-left: 19px;
}

.hpr-suite-title {
    -unity-font-style: bold;
    font-size: 20px;
    margin-bottom: 9px;
    white-space: normal;
}

.hpr-suite-status {
    -unity-font-style: bold;
    margin-top: 13px;
    margin-bottom: 8px;
    white-space: normal;
}

.hpr-suite-message {
    white-space: normal;
    margin-bottom: 11px;
    min-height: 26px;
}

.hpr-suite-section {
    -unity-font-style: bold;
    font-size: 14px;
    margin-top: 17px;
    margin-bottom: 5px;
    white-space: normal;
}

.hpr-suite-description {
    white-space: normal;
    margin-top: 3px;
    margin-bottom: 8px;
}

.hpr-suite-button {
    min-height: 29px;
    margin-top: 3px;
    margin-bottom: 5px;
    white-space: normal;
}
