# Source: /data/src/github/games/godot_llm_generated_game_lab/deploy/apache.conf.in
ProxyPreserveHost On
ProxyTimeout 240

RedirectMatch 302 ^/llm_game$ /llm_game/
Alias /llm_game/ "/data/src/github/games/godot_llm_generated_game_lab/web/"
<Directory "/data/src/github/games/godot_llm_generated_game_lab/web/">
    Options -Indexes +FollowSymLinks
    AllowOverride None
    Require all granted
</Directory>

ProxyPass /llm_game_object_asset/ http://127.0.0.1:15303/asset/
ProxyPassReverse /llm_game_object_asset/ http://127.0.0.1:15303/asset/
ProxyPass /llm_game_object/ http://127.0.0.1:15303/object/
ProxyPassReverse /llm_game_object/ http://127.0.0.1:15303/object/
ProxyPass /llm_game_llm/completion http://127.0.0.1:14829/completion
ProxyPassReverse /llm_game_llm/completion http://127.0.0.1:14829/completion
ProxyPass /llm_game_stt/ws ws://127.0.0.1:@WS_PORT@/
ProxyPassReverse /llm_game_stt/ws ws://127.0.0.1:@WS_PORT@/
ProxyPass /llm_game_stt/http/ http://127.0.0.1:@HTTP_PORT@/http/
ProxyPassReverse /llm_game_stt/http/ http://127.0.0.1:@HTTP_PORT@/http/
ProxyPass /llm_game_topic_gif/ http://127.0.0.1:@HTTP_PORT@/gif/
ProxyPassReverse /llm_game_topic_gif/ http://127.0.0.1:@HTTP_PORT@/gif/

<Location "/llm_game/">
    Require all granted
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Cross-Origin-Resource-Policy "same-origin"
</Location>
<Location "/llm_game_object/">
    Require all granted
    LimitRequestBody 16384
    Header always set Cache-Control "no-store"
    Header always set X-Content-Type-Options "nosniff"
</Location>
<Location "/llm_game_object_asset/">
    Require all granted
    Header always set Cache-Control "public, max-age=31536000, immutable"
    Header always set X-Content-Type-Options "nosniff"
</Location>
<Location "/llm_game_llm/completion">
    Require all granted
    LimitRequestBody 65536
    Header always set Cache-Control "no-store"
</Location>
<Location "/llm_game_stt/ws">
    Require all granted
    Header always set Cache-Control "no-store"
</Location>
<Location "/llm_game_stt/http/">
    Require all granted
    Header always set Cache-Control "no-store"
</Location>
<Location "/llm_game_topic_gif/">
    Require all granted
</Location>
