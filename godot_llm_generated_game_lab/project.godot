; Engine configuration file.
config_version=5

[application]
config/name="Your Mom"
config/description="A browser side-scroller with constrained LLM-written RPG semantics and identity-reviewed generated character and item animations."
run/main_scene="res://scenes/generated_world.tscn"

[display]
window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="disabled"

[physics]
2d/default_gravity=1450.0
2d/default_gravity_vector=Vector2(0, 1)
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=1

audio/driver/enable_input=false
