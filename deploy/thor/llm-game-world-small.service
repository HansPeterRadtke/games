[Unit]
Description=LLM game small world-author model on Thor
After=network-online.target
Wants=network-online.target
ConditionHost=thor
ConditionPathExists=/data/models/vlm/qwen2.5-vl-3b/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf

[Service]
Type=simple
User=hans
WorkingDirectory=/data/src/external/llama.cpp
Environment=LD_LIBRARY_PATH=/data/src/external/llama.cpp/build/bin:/usr/local/cuda-13.2/targets/sbsa-linux/lib:/usr/local/cuda/lib64
ExecStart=/data/src/external/llama.cpp/build/bin/llama-server --model /data/models/vlm/qwen2.5-vl-3b/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf --alias qwen2.5-vl-3b-world-author --host 10.8.0.7 --port 14830 --threads 14 --threads-batch 14 --ctx-size 16384 --n-gpu-layers 999 --parallel 1 --batch-size 512 --ubatch-size 128 --cache-type-k q8_0 --cache-type-v q8_0 --no-webui --no-warmup --metrics
Restart=always
RestartSec=3
TimeoutStartSec=300
TimeoutStopSec=120
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
