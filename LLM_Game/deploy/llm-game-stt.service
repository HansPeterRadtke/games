[Unit]
Description=LLM Game speech, topic, and image gateway
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
User=hans
Group=hans
WorkingDirectory=/data/src/github/games/LLM_Game
Environment=PYTHONUNBUFFERED=1
Environment=LLM_GAME_STT_BACKEND=local-first
Environment=LLM_GAME_STT_LANGUAGE=en
Environment=LLM_GAME_LOCAL_FAST_DEVICE=cpu
Environment=LLM_GAME_LOCAL_FAST_COMPUTE_TYPE=int8
Environment=LLM_GAME_ALLOW_LOCAL_STT_FALLBACK=1
Environment=LLM_GAME_WARMUP=1
Environment=XDG_CACHE_HOME=/data/var/llm_game/cache
Environment=HF_HOME=/data/var/llm_game/cache/huggingface
Environment=TRANSFORMERS_CACHE=/data/var/llm_game/cache/transformers
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=/data/src/github/games/LLM_Game/bin/run-stt.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/data/var/llm_game
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
